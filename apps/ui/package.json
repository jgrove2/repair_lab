{
  "name": "ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json && vite build",
    "preview": "vite preview",
    "deploy:dev": "pnpm build && wrangler deploy --env dev",
    "deploy:prod": "pnpm build && wrangler deploy",
    "lint": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@logto/react": "^4.1.0",
    "@repair-lab/shared": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "wrangler": "^4.0.0"
  }
}
