{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "build:dev": "tsc --noEmit && vite build --mode staging",
    "build:prod": "tsc --noEmit && vite build --mode production",
    "preview": "vite preview",
    "preview:staging": "vite preview --mode staging",
    "deploy:dev": "tsc --noEmit && vite build --mode staging && wrangler pages deploy dist --project-name repair-lab-web-dev",
    "deploy:prod": "tsc --noEmit && vite build --mode production && wrangler pages deploy dist --project-name repair-lab-web",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repair-lab/shared": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "wrangler": "^3.91.0"
  }
}
