# Copy to `.env.development` as needed (Vite loads them by mode).
# Logto SPA credentials from Logto Console.
VITE_LOGTO_ENDPOINT=https://your-tenant.logto.app
VITE_LOGTO_APP_ID=your-logto-app-id
# API identifier registered as an API resource in Logto Console.
# Must match LOGTO_API_RESOURCE on the API Worker, otherwise authenticated
# API requests fail with 401 after a successful login.
VITE_LOGTO_API_RESOURCE=https://api.yourapp.com
