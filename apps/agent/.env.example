# ── Agent env docs ───────────────────────────────────────────
# Copy and fill per environment. Never commit real tokens.
#
# Dev (talks to `pnpm --filter api dev`, i.e. repair-lab-api-dev):
#   APP_ENV=development
#   REPAIR_LAB_API_URL=http://127.0.0.1:8787
#   AGENT_SERVICE_TOKEN=dev-only-placeholder-token
#
# Prod (talks to deployed prod Worker):
#   APP_ENV=production
#   REPAIR_LAB_API_URL=https://repair-lab-api.PLACEHOLDER_ACCOUNT.workers.dev
#   AGENT_SERVICE_TOKEN=<from `wrangler secret put AGENT_SERVICE_TOKEN --env production`>
APP_ENV=development
REPAIR_LAB_API_URL=http://127.0.0.1:8787
AGENT_SERVICE_TOKEN=dev-only-placeholder-token
