{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev --port 8787",
    "dev:prod": "wrangler dev --env production --port 8788",
    "deploy": "wrangler deploy --env production",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:prod": "wrangler deploy --env production",
    "migrate:dev:local": "wrangler d1 migrations apply repair-lab-db-dev --env dev --local",
    "migrate:dev:remote": "wrangler d1 migrations apply repair-lab-db-dev --env dev --remote",
    "migrate:prod:remote": "wrangler d1 migrations apply repair-lab-db --env production --remote",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repair-lab/shared": "workspace:*",
    "hono": "^4.6.0",
    "nanoid": "^5.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.91.0"
  }
}
