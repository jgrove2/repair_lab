{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev --port 8787",
    "dev:prod": "wrangler dev --port 8788",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:prod": "wrangler deploy",
    "migrate:dev:local": "wrangler d1 migrations apply repair-lab-db-dev --env dev --local",
    "migrate:dev:remote": "wrangler d1 migrations apply repair-lab-db-dev --env dev --remote",
    "migrate:prod:remote": "wrangler d1 migrations apply repair-lab-db --remote",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repair-lab/shared": "workspace:*",
    "hono": "^4.6.0",
    "nanoid": "^5.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/node": "^26.6.3",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  }
}
