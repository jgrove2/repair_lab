# Production Pages build: talks directly to the PROD Worker.
# Used by `pnpm --filter web build` / `build:prod`.
# Replace the host after `pnpm --filter api deploy:prod` prints your prod URL.
VITE_APP_ENV=production
VITE_API_BASE=https://repair-lab-api.PLACEHOLDER_ACCOUNT.workers.dev
VITE_MOCK=false
