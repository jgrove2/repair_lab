# Staging/dev Pages build: talks directly to the DEV Worker.
# Used by `pnpm --filter web build:dev` (vite build --mode staging).
# Replace the host after `pnpm --filter api deploy:dev` prints your dev URL.
VITE_APP_ENV=staging
VITE_API_BASE=https://repair-lab-api-dev.PLACEHOLDER_ACCOUNT.workers.dev
VITE_MOCK=false
